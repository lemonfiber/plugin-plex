{
  "recorded_from": "docker.io/plexinc/pms-docker@sha256:e0ab27395614a8e1a4fdf84c6bc60ac664915cfdde70c52d030c7728a1c48e14",
  "note": "A fresh instance of this image, never claimed: no plex.tv account and no token. This is what an operator's Plex answers between install and the first-run flow, to a caller presenting nothing. Asked from the machine Docker runs on, through a published port, which Plex logged as its network's gateway. The account list, admitted from the gateway as the catalogue is.",
  "request": {
    "method": "GET",
    "path": "/accounts",
    "accept": "application/json"
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "json": {
      "MediaContainer": {
        "size": 2,
        "identifier": "com.plexapp.system.accounts",
        "Account": [
          {
            "id": 1,
            "key": "/accounts/1",
            "name": "Administrator",
            "defaultAudioLanguage": "C.",
            "autoSelectAudio": false,
            "defaultSubtitleLanguage": "C.",
            "subtitleMode": 0,
            "thumb": ""
          },
          {
            "id": 2,
            "key": "/accounts/2",
            "name": "",
            "defaultAudioLanguage": "C.",
            "autoSelectAudio": true,
            "defaultSubtitleLanguage": "C.",
            "subtitleMode": 1,
            "thumb": ""
          }
        ]
      }
    }
  }
}
